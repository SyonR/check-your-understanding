  {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OnboardingSession",
  "description": "Complete state for one developer onboarding session. Written progressively; any field may be absent while the pipeline is mid-run.",
  "type": "object",
  "properties": {

    "repo_context": {
      "description": "Output of the understand-repo phase. Populated once; enriched on subsequent runs if coverage gaps are found.",
      "type": "object",
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "source_path": { "type": "string", "description": "Absolute path of the repo that was analysed." },
        "coverage": {
          "type": "object",
          "description": "One boolean per coverage-checklist area. true = evidence found, false = gap.",
          "properties": {
            "project":      { "type": "boolean" },
            "entry_points": { "type": "boolean" },
            "architecture": { "type": "boolean" },
            "runtime_flows":{ "type": "boolean" },
            "interfaces":   { "type": "boolean" },
            "data":         { "type": "boolean" },
            "frontend":     { "type": "boolean" },
            "backend":      { "type": "boolean" },
            "infra":        { "type": "boolean" },
            "testing":      { "type": "boolean" },
            "workflow":     { "type": "boolean" },
            "conventions":  { "type": "boolean" },
            "hotspots":     { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "summary": {
          "type": "string",
          "description": "Free-text narrative of the codebase: purpose, stack, main flows, key hotspots."
        },
        "tech_tags": {
          "type": "array",
          "description": "Normalised technology identifiers detected in the repo (e.g. 'react', 'postgres', 'redis', 'docker').",
          "items": { "type": "string" }
        }
      },
      "required": ["generated_at", "source_path", "coverage", "summary", "tech_tags"]
    },

    "user_data": {
      "description": "Answers collected during the adaptive questionnaire phase. Written to user_data.json and referenced here.",
      "type": "object",
      "properties": {
        "collected_at": { "type": "string", "format": "date-time" },
        "identity": {
          "type": "object",
          "properties": {
            "name":              { "type": "string" },
            "years_experience":  { "type": "integer", "minimum": 0 },
            "role":              { "type": "string", "enum": ["junior", "mid", "senior", "lead", "other"] }
          }
        },
        "tech_familiarity": {
          "type": "object",
          "description": "Keyed by tech_tag. Values: 0 (none) – 3 (expert).",
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 3 }
        },
        "task_context": {
          "type": "object",
          "description": "The concrete work item driving this onboarding.",
          "properties": {
            "has_ticket":    { "type": "boolean" },
            "ticket_ref":    { "type": "string", "description": "Jira/Linear/GitHub issue ID or Slack thread URL." },
            "ticket_summary":{ "type": "string" },
            "goal":          { "type": "string", "description": "One-sentence description of what they need to accomplish." }
          }
        },
        "preferred_style": {
          "type": "string",
          "enum": ["bottom-up", "top-down", "example-first", "concept-first"],
          "description": "How they prefer to be taught."
        },
        "extra_answers": {
          "type": "object",
          "description": "Any additional free-form answers keyed by question id.",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["collected_at"]
    },

    "curriculum": {
      "description": "Output of the teaching-synthesis phase: the ordered teaching plan for this specific developer on this specific repo.",
      "type": "object",
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "slides": {
          "type": "array",
          "description": "Ordered list of slide specs. One slide per teaching unit.",
          "items": {
            "type": "object",
            "properties": {
              "id":       { "type": "string" },
              "title":    { "type": "string" },
              "layout":   { "type": "string", "description": "Slidev layout name (e.g. 'default', 'two-cols', 'center', 'section')." },
              "content":  { "type": "string", "description": "Markdown body for this slide." },
              "notes":    { "type": "string", "description": "Speaker notes / teaching notes for this slide." },
              "teaching_notes": { "type": "string", "description": "Remediation notes written on quiz failure; appended by the iterate-on-failure phase." }
            },
            "required": ["id", "title", "layout", "content"]
          }
        }
      },
      "required": ["generated_at", "slides"]
    },

    "quiz": {
      "description": "The single check-your-understanding quiz appended to the Slidev deck.",
      "type": "object",
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id":       { "type": "string" },
              "type":     { "type": "string", "enum": ["multiple-choice", "scenario", "where-would-you-change", "ordering", "flow-completion", "dependency-reasoning"] },
              "prompt":   { "type": "string" },
              "options":  { "type": "array", "items": { "type": "string" }, "description": "Required for multiple-choice; omit for open questions." },
              "answer":   { "type": "string", "description": "Correct option text or canonical answer." },
              "rationale":{ "type": "string", "description": "Why this is the correct answer; shown after the quiz." },
              "slide_ref":{ "type": "string", "description": "id of the slide whose content this question tests." }
            },
            "required": ["id", "type", "prompt", "answer", "rationale"]
          }
        },
        "pass_threshold": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fraction correct required to pass (e.g. 0.8)." }
      },
      "required": ["generated_at", "questions", "pass_threshold"]
    },

    "quiz_result": {
      "description": "Written after the developer completes the quiz.",
      "type": "object",
      "properties": {
        "completed_at": { "type": "string", "format": "date-time" },
        "score":        { "type": "number" },
        "passed":       { "type": "boolean" },
        "failed_question_ids": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["completed_at", "score", "passed"]
    }

  },
  "additionalProperties": false
}
